# AI Resume Screening System - Environment Configuration
# Copy this file to .env and customize for your environment

# LLM Provider: gemini, ollama, or openai
LLM_PROVIDER=gemini

# Google Gemini (free tier API key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama (optional offline alternative: https://ollama.com/)
OLLAMA_MODEL=llama3
OLLAMA_URL=http://localhost:11434

# OpenAI (optional alternative: https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server Configuration
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Optional API Security Key (leave blank for open local development)
API_KEY=

# File Upload Limit
MAX_UPLOAD_SIZE_MB=10

# Scoring Weights (Must sum to 1.0)
SEMANTIC_WEIGHT=0.40
SKILL_WEIGHT=0.30
EXPERIENCE_WEIGHT=0.15
EDUCATION_WEIGHT=0.15
